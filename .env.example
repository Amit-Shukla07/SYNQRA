# ==============================================================================
# SYNQRA Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Server Configuration
SYNQRA_APP_NAME="SYNQRA"
SYNQRA_APP_VERSION="0.1.0"
SYNQRA_HOST="127.0.0.1"
SYNQRA_PORT=8000
SYNQRA_DEBUG=false
SYNQRA_ENVIRONMENT="development"
SYNQRA_TRANSPORT="streamable-http"
SYNQRA_MCP_PATH="/mcp"
SYNQRA_STATELESS_HTTP=true

# Database Configuration (Planned)
# DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/synqra_db"

# Future Integration Placeholders (Do not commit real credentials)

# COMPOSIO_USER_ID="synqra_default_user"
# YOUTUBE_API_KEY="your-youtube-api-key"
# GITHUB_PERSONAL_ACCESS_TOKEN="your-github-token"
# TAVILY_API_KEY="your-tavily-api-key"
# GOOGLE_APPLICATION_CREDENTIALS="path/to/credentials.json"

# Agentic Orchestration & LLM Provider Configuration
SYNQRA_LLM_PROVIDER="openai"
SYNQRA_LLM_MODEL="gpt-4o-mini"
# OPENAI_API_KEY="your-openai-api-key"

# -----------------------------------------------------------------------------
# Human-in-the-Loop Approval Authentication (Phase 9.4.1 Security Hardened)
# -----------------------------------------------------------------------------
# SECURITY REQUIREMENT:
# In production and non-local environments, TLS/HTTPS termination via reverse proxy
# (e.g. Caddy, NGINX, Cloudflare) is MANDATORY to prevent credential interception.
#
# Generate high-entropy 256-bit secret tokens using:
#   openssl rand -hex 32
# or in Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Primary API Key:
# Supports either a raw high-entropy bearer token (min 32 chars in production)
# or a pre-hashed SHA-256 token (format: sha256:<64_hex_digits>)
# SYNQRA_APPROVAL_API_KEY="your-high-entropy-approval-api-key"
# SYNQRA_APPROVAL_DEFAULT_OPERATOR="primary_operator"
# SYNQRA_APPROVAL_DEFAULT_ROLES="operator"
# SYNQRA_APPROVAL_DEFAULT_ALLOWED_WORKFLOWS=""
#
# Secret key for HMAC argument binding and anti-tamper token signing:
# SYNQRA_APPROVAL_SECRET_KEY="your-high-entropy-approval-signing-secret"
#
# Multi-Operator Tokens:
# Can be stored using raw tokens or secure pre-hashed SHA-256 digests.
# Format options:
# 1. Comma-separated: sha256:<hash>:operator_id:role1|role2:wf1|wf2
#    e.g. SYNQRA_APPROVAL_TOKENS="sha256:abcd...:alice:operator:wf_1,sha256:ef01...:bob:admin"
# 2. JSON mapping:
#    SYNQRA_APPROVAL_TOKENS='{"sha256:abcd...": {"operator_id": "alice", "roles": ["operator"], "allowed_workflows": ["wf_1"]}}'
# SYNQRA_APPROVAL_TOKENS=""

# ---------------------------------------------------------------------------
# Phase 9.5: Durable Persistence & LangGraph Checkpointer
# ---------------------------------------------------------------------------
# LangGraph state checkpoint backend: "memory" (default for testing/dev) or "postgres" (durable production)
# SYNQRA_CHECKPOINTER_TYPE="memory"
# Connection pool settings for PostgreSQL checkpointer:
# SYNQRA_CHECKPOINTER_POOL_MIN_SIZE=1
# SYNQRA_CHECKPOINTER_POOL_MAX_SIZE=5
